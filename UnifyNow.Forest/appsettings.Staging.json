{
  "ConnectionStrings": {
    "ForestDb": "Data Source=YOUR_SQL_HOST;Initial Catalog=ForestDb;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True",
    "IdentityDb": "Data Source=YOUR_SQL_HOST;Initial Catalog=LatestUnifyIdentityDb;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True"
  },
  "ElasticSearchSettings": {
    "Url": "https://YOUR_ELASTICSEARCH_HOST:9200",
    "DefaultIndex": "objectindex",
    "UserName": "YOUR_ELASTICSEARCH_USER",
    "Password": "YOUR_PASSWORD",
    "Fingerprint": "YOUR_ELASTICSEARCH_FINGERPRINT"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
