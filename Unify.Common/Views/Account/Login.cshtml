                    value="CfDJ8EUy7qFKZAtGlFIhm98EWuZ_BuCPyjq9860nTV4P0TwKZSXErGyzpOsO2thCMiFkO4CF1CBymOnoYVdYNVYj65iNXA1DwnCsTzGWXIgavptjAGI3tzs8M_uAFcgnWGhJw9lLE8J6VNFm61JhkqaFZSc" />
                    *@
                </form>

            </div>
        </div>
    </div>
</div>
<div class="col-md-6">
    <div class="login-right">
        <div>
            <p>Your Gateway to AI-Powered Workplace Solutions</p>
            <img src="/images/companyLogos.png"
                 alt="productlogos"
                 class="img-fluid" />
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
