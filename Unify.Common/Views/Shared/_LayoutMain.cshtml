<!DOCTYPE html>
<html lang="en">
<head>
    @* <title>Registration/Login</title> *@
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins"
      rel="stylesheet"
    />
    <style>
      .vi-login {
        position: fixed;
        width: 100%;
        font-family: "Poppins";
      }
      .login-right {
        background-image: url("/images/signin-bg.png");
        background-repeat: no-repeat;
        background-size: cover;
        justify-content: center;
        align-items: center;

        height: calc(100vh - 0px);
        width: 100%;
        display: flex;
        flex-direction: column;
        text-align: center;
      }
      .login-right p {
        color: #ffffff;
        font-size: 20px;
        text-align: center;
        margin-top: 30%;
      }
      .login-right img {
        height: 65%;
        width: auto;
        object-fit: contain;
      }
      .or-border {
        border-bottom: 1px solid #9c9aa54d;
        width: 70%;
      }
      .login-btn {
        margin: 10px 0;
      }
      .login-btn button {
        padding: 10px 30px;
        width: 100%;
      }
      .login-form {
        margin-top: 30px;
      }
      .login-form input {
        padding: 0.7rem;
        border: 1px solid #465ff166;
        box-shadow: 0px 4px 8px 0px #465ff11a;
        font-size: 14px;
      }
      .login-form label {
        font-size: 15px;
        margin-bottom: 2px;
      }
      .create-acc {
        margin-top: 10px;
      }
      .social-links {
        justify-content: space-between;
      }
      .social-links button {
        border: 1px solid #465ff166;
        border-radius: 6px;
        background: white;
        flex: 0 0 31%;
        padding: 9px;
      }
      .welcome {
        font-weight: bold;
        font-size: 30px;
        color: #000000;
        line-height: 50px;
      }
      .welcome span {
        color: #0a58ca;
        font-size: 40px;
      }
      .welcome span b {
        font-size: 14px;
      }
      .or-text span {
        background: white;
        color: #9c9aa54d;
      }
      .unify-logo {
        margin-bottom: 30px;
      }
      .signin-tabs {
        background: #ecf0ff;
        padding: 6px;
      }
      .signin-tabs li a {
        color: #9c9aa5;
      }
      .forgot-password {
        text-decoration: none;
        font-size: 14px;
        text-align: right;
        width: 100%;
        display: block;
        margin-top: 4px;
      }
      .registration-form {
        margin: auto;
        width: 63%;
      }
      .signin-up p {
        font-size: 14px;
        text-align: center;
        margin-top: 10px;
      }
      .signin-up a {
        text-decoration: none;
      }
      @@media only screen and (max-width: 991px) {
        .registration-form {
          width: 80%;
        }
        .login-right img {
          width: 90%;
        }
      }
      @@media only screen and (max-width: 767px) {
        .registration-form {
          width: 90%;
        }
        .login-right img {
          width: 20%;
        }
        .vi-login {
          position: unset;
        }
        .login-right p {
          margin-top: 0;
          padding-top: 30px;
          font-size: 16px;
        }
        .unify-logo {
          text-align: center;
          margin-top: 30px;
        }
        .vi-login .row {
          height: auto !important;
          flex-direction: column-reverse;
        }
        .login-right {
          height: auto;
        }
        #external-account {
          margin-bottom: 20px;
        }
      }
    </style>
  </head>
<body class="vi-login">

    <div class="row align-items-center" style="height: 100vh">
        @RenderBody()
    </div>

    @* <script src="~/lib/jquery/dist/jquery.slim.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
 *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @* <script src="~/js/site.js" asp-append-version="true"></script> *@



    @RenderSection("scripts", required: false)
</body>
</html>
