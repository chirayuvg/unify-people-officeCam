@using AppStudio.Framework.Core;
@using AppStudio.Model;
@using DevExtreme.AspNet.Mvc
@using Newtonsoft.Json
@using Unify.People.Controllers.Visitors
@model CheckInModel
@inject AppModel appModel

@{
    if (!this.Context.Request.IsAjax())
    {
        Layout = appModel.DefaultMenu.GetLayoutUrl();
    }
}

<style>
    body {
        margin: 0;
        font-family: sans-serif;
    }

    header .content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 10px;
    }

    .title {
        text-align: center;
        color: black;
        font-size: 20px;
        margin: 0 0 0 20px;
    }

    .logos {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .logos img {
        height: 37px;
        object-fit: contain;
    }

    .divider {
        background: #8080805e;
        height: 50px;
        display: inline-block;
        width: 2px;
    }

    #video {
        width: 50%;
        height: auto;
        border: 2px solid #ccc;
        border-radius: 8px;
    }

    #capturedImage {
        height: calc(100vh - 100px);
        width: 100%;
        object-fit: cover;
        border: 1px solid red;
        border-radius: 8px;
    }

    #capturedImage {
        display: none;
    }

    .videoFeed {
        display: flex;
        align-items: center;
        margin: 20px;
    }

    .accessedFeilds,
    .rightContent {
        flex: 0 0 50%;
    }

    .checkInButton {
        text-align: center;
    }

    .checkInButton button {
        background: #6a7efc;
        padding: 10px 15px;
        color: white;
        font-size: 16px;
        border-radius: 6px;
        cursor: pointer;
        border: 1px solid #6a7efc;
    }

    .checkInButton button:hover {
        background: white;
        color: #6a7efc;
    }

    .checkInSuccesfull {
        display: grid;
        justify-content: center;
        flex: 0 0 50%;
    }

    .checkInSuccesfull h3 {
        text-align: center;
        color: #06ab06;
    }

    .checkInSuccesfull p {
        font-size: 15px;
        color: rgb(62, 59, 59);
    }

    .checkInDetails {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .checkInDetails img {
        height: 100px;
        width: 100px;
        object-fit: cover;
        border-radius: 50%;
        border: 1px solid black;
    }

    .checkInTimings {
        display: flex;
        gap: 20px;
        justify-content: left;
        line-height: 0px;
        margin-bottom: 10px;
    }

    .captureAgain {
        text-align: center;
    }

    .captureAgain button {
        background: #6a7efc;
        padding: 10px 15px;
        border: 4px;
        color: white;
        font-size: 16px;
        border-radius: 6px;
        cursor: pointer;
        border: 1px solid #6a7efc;
    }

    .captureAgain button:hover {
        background: white;
        color: #6a7efc;
    }

    .close span {
        color: white;
        background: #eb0f0f;
        padding: 5px 6px;
        border-radius: 50%;
        font-size: 9px;
        font-weight: bold;
        cursor: pointer;
        border: 1px solid #eb0f0f;
    }

    .close span:hover {
        color: #eb0f0f;
        background: white;
    }

    .mobileTitle {
        display: none;
    }

    #gridContainer {
        margin-top: 40px;
    }

    #checkInGrid .dx-datagrid-headers .dx-header-row > td {
        font-weight: bold;
    }

    @@media screen and (max-width: 768px) {
        .title {
            display: none;
        }

        .mobileTitle {
            display: block;
            font-size: 18px;
            line-height: 26px;
            margin: 5px;
        }

        .videoFeed {
            flex-direction: column;
        }

        .accessedFeilds,
        .rightContent {
            flex: 0 0 100%;
            width: 100%;
        }

        #video,
        #capturedImage {
            height: auto;
            width: 100%;
            max-height: 400px;
        }

        .checkInSuccesfull {
            padding: 10px;
        }

        .checkInDetails {
            flex-direction: column;
            align-items: center;
        }

        .checkInTimings {
            gap: 10px;
            flex-wrap: wrap;
        }

        .checkInTimings p {
            margin: 5px;
        }

        .checkInDetails img {
            display: none;
        }
    }
</style>

<input type="hidden" id="AppointmentId" value="@Model.AppointmentId" />

<main id="CaptureMain">
    <div style="position: relative; margin-bottom: 15px; height: 40px;">
        <h2 id="visitorCounter" style="margin: 0; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">
            Visitor: @ViewBag.StartVisitor/@ViewBag.NoOfVisitors
        </h2>

@*         <div style="position: absolute; right: 30px; top: 50%; transform: translateY(-50%);">
            <a href="javascript:history.back()"
               style="text-decoration: none; color: #2196f3; font-size: 18px; font-weight: bold; display: flex; align-items: center;">
                <span style="font-size: 20px; margin-right: 4px;">&#x276E;</span> BACK
            </a>
        </div>
 *@    
 <div style="position: absolute; right: 30px; top: 50%; transform: translateY(-50%);">
            <a href="javascript:void(0);"
               onclick="handleBackClick();"
               style="text-decoration: none; color: #2196f3; font-size: 18px; font-weight: bold; display: flex; align-items: center;">
                <span style="font-size: 20px; margin-right: 4px;">&#x276E;</span> BACK
            </a>
        </div>

</div>

    <div class="videoFeed">
        <div class="accessedFeilds">
            <video id="video" autoplay></video>
            <img id="capturedImage" alt="Captured Frame" />
        </div>

        <div class="rightContent" id="rightContent">
            <div class="checkInButton" id="checkInButton">
                <button id="checkInBtn">CheckIn</button>
                <button id="checkInPrint" onclick="printGatePass();">Print Gatepass</button>
            </div>
            <div class="checkInSuccesfull" id="chekinSuccess">
            </div>
        </div>
    </div>

    <div id="gridContainer">
        <script>
            function onRowRemoved(e) {
                decreaseCounter();
            }
        </script>

        @(
            Html.DevExtreme().DataGrid()
                .ID("checkInGrid")
                .DataSource(ds => ds.Mvc()
                    .Controller("VisitorLog")
                    .LoadAction("GetVisitors").LoadParams(new { AppointmentId = Model.AppointmentId, VisitorId = Model.VisitorId })
                    .UpdateAction("UpdateVisitorLog")
                    .DeleteAction("DeleteVisitorLog")
                    .Key("id")
                )
                .KeyExpr("id")
                .ShowBorders(true)
                .Columns(columns =>
                {
                    columns.Add().DataField("badgeNo").Caption("Badge No");
                    columns.Add().DataField("visitorName").Caption("Visitor Name");
                    columns.Add().DataField("mobileNo").Caption("Mobile No");
                    columns.Add().DataField("company").Caption("Company");
                    columns.Add().DataField("address").Caption("Address");
                    columns.Add().DataField("employeeId").Caption("Employee")
                        .Lookup(lookup => lookup
                        .DataSource(ds => ds.Mvc()
                            .Controller("VisitorLog")
                            .LoadAction("GetEmployees")
                        )
                        .ValueExpr("id")
                        .DisplayExpr("name")
                    ).CalculateDisplayValue("employeeName");
                    columns.Add().Type(GridCommandColumnType.Buttons).Buttons(buttons =>
                    {
                        buttons.Add().Name(GridColumnButtonName.Edit);
                        buttons.Add().Name(GridColumnButtonName.Delete);
                    });
                })
                .Editing(editing =>
                {
                    editing.Mode(GridEditMode.Row);
                    editing.AllowUpdating(true);
                    editing.AllowDeleting(true);
                })
                .OnRowRemoved("onRowRemoved")
                .Paging(p => p.PageSize(5))
                .Pager(pager =>
                {
                    pager.ShowPageSizeSelector(false);
                    pager.ShowNavigationButtons(true);
                    pager.AllowedPageSizes(new JS("[5]"));
                    pager.ShowInfo(true);
                pager.Visible(true);
            })
        )
    </div>
</main>

<script type="text/javascript" src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/smoothness/jquery-ui.css">



<script>

   //  video = document.getElementById("video");

   //  checkInBtn = document.getElementById("checkInBtn");
   //  checkInPrint = document.getElementById("checkInPrint");
   //  capturedImage = document.getElementById("capturedImage");
   //  visitorCounter = document.getElementById("visitorCounter");

   //  let currentLatitude, currentLongitude;
   //  let locationWatcherID;

   //  // Visitor counting logic
   //  let currentVisitor = @ViewBag.StartVisitor;
   // let  totalVisitors = @ViewBag.NoOfVisitors;
       window.video = window.video || document.getElementById("video");
    window.checkInBtn = window.checkInBtn || document.getElementById("checkInBtn");
    window.checkInPrint = window.checkInPrint || document.getElementById("checkInPrint");
    window.capturedImage = window.capturedImage || document.getElementById("capturedImage");
    window.visitorCounter = window.visitorCounter || document.getElementById("visitorCounter");

    // Only assign if not already set
    window.currentLatitude = window.currentLatitude ?? null;
    window.currentLongitude = window.currentLongitude ?? null;
    window.locationWatcherID = window.locationWatcherID ?? null;

    // Visitor counting logic
    window.currentVisitor = window.currentVisitor ?? @ViewBag.StartVisitor;
    window.totalVisitors = window.totalVisitors ?? @ViewBag.NoOfVisitors;

    // If currentVisitor EQUALS totalVisitors, should be hidden
    if (currentVisitor == totalVisitors) checkInBtn.style.display = "none";

    // If currentVisitor > 0 then ONLY Print button would be visible
    if (currentVisitor == 0) checkInPrint.style.display = "none"; else checkInPrint.style.display = "inline-block";

    async function startCamera() {
        //alert('Start Camera');

        try {
            const stream = await navigator.mediaDevices.getUserMedia({ video: true, });
            video.srcObject = stream;
            window.localStream = stream;
        }
        catch (error) {
            alert("Camera access denied or not supported.");
            console.error(error);
        }
    }

        async function stopCamera() {
        if (window.localStream) {
            const tracks = window.localStream.getTracks();
            for (const track of tracks) {
                if (track.readyState === 'live') {
                    track.stop();
                }
            }
            window.localStream = null;
        }
    }

        async function handleBackClick() {
        await stopCamera();   // Call your async stopCamera() function

             delete window.video;
     delete window.checkInBtn;
     delete window.checkInPrint;
     delete window.capturedImage;
     delete window.visitorCounter;
     delete window.currentLatitude;
     delete window.currentLongitude;
     delete window.locationWatcherID;
     delete window.currentVisitor;
     delete window.totalVisitors;
     delete window.localStream;

        history.back();       // Go back after camera is stopped
    }



    function trackLocation() {
        //alert('Track Location');

        if ("geolocation" in navigator) {
            locationWatcherID = navigator.geolocation.watchPosition(
                (position) => {
                    currentLatitude = position.coords.latitude;
                    currentLongitude = position.coords.longitude;
                },
                (error) => {
                    alert("Location access denied or unavailable.");
                    console.error(error);
                },
                {
                    enableHighAccuracy: true,
                    maximumAge: 1000,
                }
            );
        }
        else {
            alert("Geolocation is not supported by this browser.");
        }
    }

    checkInBtn.addEventListener("click", () => {
        showLoadPanel();

        const canvas = document.createElement("canvas");
        canvas.width = video.videoWidth;
        canvas.height = video.videoHeight;
        const context = canvas.getContext("2d");
        context.drawImage(video, 0, 0, canvas.width, canvas.height);

        const dataUrl = canvas.toDataURL("image/png");
        capturedImage.src = dataUrl;

        canvas.toBlob(function (blob) {
            const file = new File([blob], "capture.jpg", { type: "image/jpeg" });
            const formData = new FormData();
            formData.append("Image", file);
            formData.append("Latitude", currentLatitude || "");
            formData.append("Longitude", currentLongitude || "");
            formData.append("AppointmentId", document.getElementById("AppointmentId").value || "");

            $.ajax({
                url: '/VisitorLog/Capture',
                method: 'POST',
                data: formData,
                processData: false,
                contentType: false,

                success: function (data) {
                    $('#chekinSuccess').html(data);
                    hideLoadPanel();
                },
                error: function () {
                    hideLoadPanel();
                    alert('Upload failed.');
                }
            });
        }, 'image/jpeg');
    });

    function printGatePass() {
        const pdfUrl = '/VisitorLog/PrintGatePass?AID=@Model.AppointmentId';
        window.open(pdfUrl, '_blank');
    }

    function hideInfo() {
        $("#checkInButton").show();
        $("#chekinSuccess").html("");
    }

    function increaseCounter()
    {
        //alert('increaseCounter');

        currentVisitor++;

        visitorCounter.innerText = `Visitor: ${currentVisitor}/${totalVisitors}`;
        if (currentVisitor == 0) checkInPrint.style.display = 'none'; else checkInPrint.style.display = 'inline-block';

        $('#checkInGrid').dxDataGrid('instance').refresh();

        if (currentVisitor >= totalVisitors) {
            $('#checkInBtn').hide();
        }
        else {
            $('checkInBtn').show();
        }
    }

    function decreaseCounter() {
        //alert('decreaseCounter');

        currentVisitor--;
        visitorCounter.innerText = `Visitor: ${currentVisitor}/${totalVisitors}`;
        if (currentVisitor == 0) checkInPrint.style.display = 'none'; else checkInPrint.style.display = 'inline-block';

        $('#checkInGrid').dxDataGrid('instance').refresh();

        if (currentVisitor < totalVisitors) $('#checkInBtn').show();
    }

    window.addEventListener('pageshow', function (event) {
        if (event.persisted || performance.getEntriesByType("navigation")[0].type === "back_forward") {
            // Page was restored from back-forward cache
            // Re-initialize camera
            stopCamera();
            startCamera();
            trackLocation();
        }
    });

    // Also run on first load
    document.addEventListener("DOMContentLoaded", function () {
          stopCamera();
        startCamera();
        trackLocation();
    });

    // Optional: Stop camera on unload
    window.addEventListener("beforeunload", function () {
        if (window.localStream) {
            window.localStream.getTracks().forEach(track => track.stop());
        }
    });
    stopCamera();
     startCamera();
     trackLocation();
</script>
