@using AppStudio.Framework.Core;
@using AppStudio.Model;
@using DevExtreme.AspNet.Mvc
@using Unify.People.Controllers.Visitors
@model CheckInModel
@inject AppModel appModel

@{
    if (!this.Context.Request.IsAjax())
    {
        Layout = appModel.DefaultMenu.GetLayoutUrl();
    }
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div id="divUpdateVisitor" class="dx-form">
    <h3>Check In Successful</h3>
    <center><h4 style="color:blue">Update Visitor</h4></center>

    <form id="confirmVisitor" enctype="multipart/form-data">
        <input type="hidden" asp-for="AppointmentId" />
        <input type="hidden" asp-for="Latitude" />
        <input type="hidden" asp-for="Longitude" />
        <input type="hidden" asp-for="ImageBase64String" />
        <input type="hidden" asp-for="VisitorId" />

        <div class="container">
            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Name *</label>
                <div class="col-sm-8">
                    <input asp-for="VisitorName" class="form-control" required />
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Mobile *</label>
                <div class="col-sm-8">
                    <input asp-for="MobileNo" type="text" class="form-control" required />
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Company *</label>
                <div class="col-sm-8">
                    <input asp-for="Company" class="form-control" required />
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Address</label>
                <div class="col-sm-8">
                    <input asp-for="Address" class="form-control" required />
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Email</label>
                <div class="col-sm-8">
                    <input asp-for="Email" class="form-control" />
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Badge No *</label>
                <div class="col-sm-8">
                    <input asp-for="BadgeNo" class="form-control" required />
                </div>
            </div>
        </div>
    </form>

    <br />

    <div class="form-group row">
        <div class="col-sm-12 text-center">
            <button id="saveVisitorBtn" class="btn btn-primary" onclick="submitForm('confirmVisitor', '/VisitorLog/UpdateVisitor')">Submit</button>
        </div>
    </div>
</div>
