<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>2a93112d-f9f5-4ec0-a118-28339a773801</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerComposeProjectPath>..\docker-compose.dcproj</DockerComposeProjectPath>
	<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
	<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	<RazorCompileOnBuild>false</RazorCompileOnBuild>
	<RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>

  <!--
    The existing source tree is generated legacy UI. It is deliberately kept
    in the repository as a migration reference, but does not participate
    in this no-UI/no-database host. Native service classes are added explicitly
    as they are migrated.
  -->
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Application\**\*.cs" />
    <Compile Include="Contracts\**\*.cs" />
    <Compile Include="Domain\**\*.cs" />
    <RazorGenerate Remove="**\*.cshtml" />
  </ItemGroup>
</Project>
