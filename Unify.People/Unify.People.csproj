  </PropertyGroup>

  <ItemGroup>
	  <PackageReference Include="AppStudio.Framework.MVC" Version="1.0.145" />
	  <PackageReference Include="EPPlus" Version="7.7.2" />
	  <PackageReference Include="ESC-POS-USB-NET" Version="1.1.3" />
	  <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.0" />
	  <PackageReference Include="QuestPDF" Version="2025.5.1" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\VisitorPass\" />
  </ItemGroup>
</Project>
