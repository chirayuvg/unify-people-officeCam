        async function getBase64FromImageUrl(url) {
            const response = await fetch(url, { cache: "no-cache" }); // prevent caching issues

            if (!response.ok) {
                throw new Error(`Failed to fetch image: ${response.status} ${response.statusText}`);
            }

            const blob = await response.blob();
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onloadend = () => resolve(reader.result); // Base64 result
                reader.onerror = reject;
                reader.readAsDataURL(blob); // convert blob → base64
            });
        }

        async function downloadPDF_OnClick() {
            // Hide the button before capturing
            const btnViewAll = document.getElementById("btnViewAll");
            let originalDisplay = "";                           // Save current display style
            if (btnViewAll) {
                btnViewAll.click();

                originalDisplay = btnViewAll.style.display;     // inline style, may be empty
                btnViewAll.style.display = "none";              // hide during PDF creation
            }

            // Load logo first
            const logoImg = await getBase64FromImageUrl("/Images/sathyamangalamLogo.png");

            const sections = document.querySelectorAll('.pdf-section');
            const pdf = new jspdf.jsPDF('p', 'mm', 'a4');
            const pageWidth = pdf.internal.pageSize.getWidth();
            const pageHeight = pdf.internal.pageSize.getHeight();

            function addHeaderLine(label, value, x, y) {
                pdf.setFont("helvetica", "bold");
                pdf.text(label, x, y);
                const labelWidth = pdf.getTextWidth(label);
                pdf.setFont("helvetica", "normal");
                pdf.text(value, x + labelWidth + 2, y);
            }

            let pageCount = 0;  // count pages added

            for (let i = 0; i < sections.length; i++) {
                const section = sections[i];

                section.style.display = 'block';
                section.style.overflow = 'visible';
                section.style.transform = 'scale(1)';
                section.style.transformOrigin = 'top left';
                await new Promise(resolve => setTimeout(resolve, 300));

                const canvas = await html2canvas(section, {
                    scale: 2,
                    useCORS: true,
                    backgroundColor: '#ffffff',
                    scrollY: -window.scrollY,
                    windowWidth: document.body.scrollWidth
                });

                const imgData = canvas.toDataURL('image/png');
                const imgWidth = pageWidth;
                const imgHeight = (canvas.height * imgWidth) / canvas.width;

                if (i !== 0) pdf.addPage();
                pageCount++;

                // --- HEADER BLOCK ---
                pdf.setFontSize(12);
                const xAlign = 4;
                let yOffset = 15;

                // Logo top-left
                if (logoImg) {
                    pdf.addImage(logoImg, "PNG", 4, 8, 15, 15);
                }

                // Heading
                pdf.setFontSize(18);
                pdf.setFont("helvetica", "bold");
                const heading = "Tamil Nadu Forest Department";
                const headingWidth = pdf.getTextWidth(heading);
                pdf.text(heading, (pageWidth - headingWidth) / 2, 15);

                // Address
                pdf.setFontSize(10);
                pdf.setFont("helvetica", "normal");
                const address = "Company Address Line 1, Line 2, City, PIN";
                const addressWidth = pdf.getTextWidth(address);
                pdf.text(address, (pageWidth - addressWidth) / 2, 21);

                // Line separator
                pdf.setLineWidth(0.5);
                pdf.line(4, 25, pageWidth - 4, 25);

                pdf.setFontSize(12);
                yOffset = 35;
                const divisionText = document.getElementById("DivisionId").options[
                    document.getElementById("DivisionId").selectedIndex
                ].text;
                addHeaderLine("Division:     ", divisionText, xAlign, yOffset);

                yOffset += 7;
                const rangeText = document.getElementById("RangeId").options[
                    document.getElementById("RangeId").selectedIndex
                ].text;
                addHeaderLine("Range:        ", rangeText, xAlign, yOffset);

                yOffset += 7;
                const sectionText = document.getElementById("SectionId").options[
                    document.getElementById("SectionId").selectedIndex
                ].text;
                addHeaderLine("Section:      ", sectionText, xAlign, yOffset);

                yOffset += 7;
                const beatText = document.getElementById("BeatId").options[
                    document.getElementById("BeatId").selectedIndex
                ].text;
                addHeaderLine("Beat:           ", beatText, xAlign, yOffset);

                yOffset += 7;
                const employeeText = document.getElementById("EmployeeId").options[
                    document.getElementById("EmployeeId").selectedIndex
                ].text;
                addHeaderLine("Employee:  ", employeeText, xAlign, yOffset);

                yOffset += 7;

                // From Date / To Date
                pdf.setFont("helvetica", "bold");
                pdf.text("From Date: ", xAlign, yOffset);
                let fromLabelWidth = pdf.getTextWidth("From Date: ");
                const fromDate = document.getElementById("FromDate").value;
                pdf.setFont("helvetica", "normal");
                pdf.text(fromDate, xAlign + fromLabelWidth + 2, yOffset);
                let fromDateWidth = pdf.getTextWidth(" " + fromDate + " ");
                pdf.setFont("helvetica", "bold");
                pdf.text("To Date: ", xAlign + fromLabelWidth + fromDateWidth + 8, yOffset);
                let toLabelWidth = pdf.getTextWidth("To Date: ");
                const toDate = document.getElementById("ToDate").value;
                pdf.setFont("helvetica", "normal");
                pdf.text(toDate, xAlign + fromLabelWidth + fromDateWidth + toLabelWidth + 10, yOffset);

                yOffset += 5;
                pdf.setLineWidth(0.5);
                pdf.line(4, yOffset, pageWidth - 4, yOffset);

                yOffset += 5;

                // --- SECTION IMAGE ---
                if (imgHeight <= (pageHeight - yOffset)) {
                    pdf.addImage(imgData, 'PNG', 0, yOffset, imgWidth, imgHeight);
                } else {
                    let position = yOffset;
                    let remainingHeight = imgHeight;
                    while (remainingHeight > 0) {
                        pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
                        remainingHeight -= pageHeight;
                        if (remainingHeight > 0) {
                            pdf.addPage();
                            pageCount++;
                            position = -remainingHeight + yOffset;
                        }
                    }
                }
            }

            const totalPages = pdf.internal.getNumberOfPages();
            const generatedDate = new Date().toLocaleDateString('en-GB');
            const userName = "@ViewBag.UserName";

            // --- ADD FOOTERS TO ALL PAGES ---
            for (let j = 1; j <= totalPages; j++) {
                pdf.setPage(j);
                const footerY = pageHeight - 10;
                pdf.setLineWidth(0.5);
                pdf.line(4, footerY - 5, pageWidth - 4, footerY - 5);
                pdf.setFontSize(9);
                pdf.setFont("helvetica", "normal");
                pdf.text(`Report generated on ${generatedDate}, by ${userName}`, 4, footerY);
                const pageText = `Page ${j} of ${totalPages}`;
                const textWidth = pdf.getTextWidth(pageText);
                pdf.text(pageText, pageWidth - textWidth - 4, footerY); // align right
            }

            pdf.save('Attendance_Report.pdf');

            // Show the button again after PDF is created
            if (btnViewAll) btnViewAll.style.display = originalDisplay || "";
        }

