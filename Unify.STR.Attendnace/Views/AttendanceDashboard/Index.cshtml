        }

        .item-name {
        font-weight: bold;
        font-size: 1.1rem;
        margin-bottom: 5px;
        }

        .item-location {
        color: #555;
        font-size: 0.95rem;
        }

        .item-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        justify-content: flex-end;
        }

        .tag {
        background-color: #d0e8fe;
        color: #000;
        border-radius: 12px;
        padding: 4px 10px;
