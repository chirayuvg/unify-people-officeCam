        // Draw Attendance Chart with Google Charts
                function drawAttendanceChart(data) {

            const total = data.present + data.late + data.absent;
         // const percentage = Math.round((data.present / total) * 100);

         //   if (isNaN(percentage)) percentage = 0;

            // Update percentage display
       //     document.getElementById('attendancePercentage').textContent = percentage + '%';

            // Update counts
            document.getElementById('presentCount').textContent = data.present;
            document.getElementById('lateCount').textContent = data.late;
            document.getElementById('absentCount').textContent = data.absent;

            // Update bar heights proportionally with minimum height
            const maxValue = Math.max(data.present, data.late, data.absent);
            const presentBar = document.getElementById('presentBar');
            const lateBar = document.getElementById('lateBar');
            const absentBar = document.getElementById('absentBar');

            // Calculate heights with minimum 20px for visibility
            const minHeight = 20;
            const maxHeight = 300;

            const presentHeight = data.present === 0 ? 0 : Math.max(minHeight, (data.present / maxValue) * maxHeight);
            const lateHeight = data.late === 0 ? 0 : Math.max(minHeight, (data.late / maxValue) * maxHeight);
            const absentHeight = data.absent === 0 ? 0 : Math.max(minHeight, (data.absent / maxValue) * maxHeight);

            presentBar.style.height = presentHeight + 'px';
            lateBar.style.height = lateHeight + 'px';
            absentBar.style.height = absentHeight + 'px';
        }

