@using Unify.STR.Attendance.Data.SQL
@model FilterSelectionViewModel

@{
    Layout = null;

    bool isCCF = (ViewBag.Designation == "CCF");
    bool isDFO = (ViewBag.Designation == "DFO");
    bool isRanger = (ViewBag.Designation == "Ranger");

    bool isNoDesignation = (!isCCF && !isDFO && !isRanger) ? true : false;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Attendance Dashboard</title>
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Choices.js CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <!-- Google Charts -->
    <script type="text/javascript">
        // Fallback loader for Google Charts
        window.loadGoogleCharts = function(callback) {
        var script = document.createElement('script');
        script.type = 'text/javascript';
        script.src = 'https://www.gstatic.com/charts/loader.js';
        script.onload = callback;
        script.onerror = function () {
        console.error("Failed to load Google Charts");
        };
        document.head.appendChild(script);
        };

        // Fallback loader for Choices.js
        window.loadChoicesJS = function(callback) {
        if (typeof Choices !== 'undefined') {
        callback();
        return;
        }

        var link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css';
        document.head.appendChild(link);

        var script = document.createElement('script');
        script.type = 'text/javascript';
        script.src = 'https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js';
        script.onload = callback;
        script.onerror = function () {
        console.error("Failed to load Choices.js");
        };
        document.head.appendChild(script);
        };

        // Fallback loader for Flatpickr
        window.loadFlatpickr = function(callback) {
        if (typeof flatpickr !== 'undefined') {
        callback();
        return;
        }

        var link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css';
        document.head.appendChild(link);

        var script = document.createElement('script');
        script.type = 'text/javascript';
        script.src = 'https://cdn.jsdelivr.net/npm/flatpickr';
        script.onload = callback;
        script.onerror = function () {
        console.error("Failed to load Flatpickr");
        };
        document.head.appendChild(script);
        };
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <style>
        /* All your existing CSS styles */
        .user-name {
        color: rgb(0, 0, 140);
        }

        .select-wrapper {
        position: relative;
        margin: 18px 0;
        }

        .select-wrapper .bi {
        position: absolute;
        top: 50%;
        left: 12px;
        transform: translateY(-50%);
        pointer-events: none;
        color: #6c757d;
        z-index: 9;
        }

        .select-wrapper .choices__inner {
        font-weight: bold;
        color: #000;
        background-color: #d0e8fe;
        border-radius: 8px;
        border: none !important;
        box-shadow: none !important;
        padding-left: 2rem !important;
        }

        .choices__list--dropdown .choices__item {
        font-weight: bold;
        color: #000;
        background-color: #fff;
        }

        .choices__list--dropdown .choices__item--selectable.is-highlighted {
        background-color: #d0e8fe;
        }

        .select-wrapper-multy {
        position: relative;
        }

        .select-wrapper-multy .bi {
        position: absolute;
        top: 50%;
        left: 12px;
        transform: translateY(-50%);
        color: #333;
        pointer-events: none;
        z-index: 10;
        }

        .select-wrapper-multy .choices__inner {
        background-color: #d0e8fe;
        border: none !important;
        border-radius: 8px;
        padding-left: 2rem !important;
        font-weight: bold;
        color: #000;
        }

        .choices__item--choice {
        font-weight: bold;
        }

        .choices__item--multiple {
        background-color: #007bff;
        color: white;
        border-radius: 20px;
        padding: 5px 10px;
        margin: 2px;
        }

        .date-range-container {
        background-color: #d0e8fe;
        border-radius: 8px;
        font-weight: bold;
        color: #000;
        padding: 10px 15px;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        }

        .date-range-container input {
        background-color: transparent;
        border: none;
        outline: none;
        font-weight: bold;
        color: #000;
        width: 140px;
        }

        .date-range-container input::placeholder {
        color: #666;
        }

        .date-range-container span {
        font-weight: bold;
        color: #000;
        }

        .flatpickr-calendar {
        z-index: 9999 !important;
        }

        .chart-design {
        border: solid 2px #666;
        border-radius: 16px;
        margin-top: 2rem;
        padding: 20px;
        }

        .full-screen-list {
        height: 100vh;
        overflow-y: auto;
        padding: 20px;
        }

        .list-item {
        background: #ffffff;
        border-radius: 8px;
        padding: 15px 20px;
        margin-bottom: 15px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        box-shadow: 0 0 10px rgba(0,0,0,0.05);
        }

        .item-left {
