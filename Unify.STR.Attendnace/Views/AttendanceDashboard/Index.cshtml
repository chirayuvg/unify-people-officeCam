        function downloadAttendanceReport() {
          const element = document.getElementById('reportContent');

          // Store original styles to restore later
          const originalStyle = element.getAttribute('style') || '';

          // Temporarily set width and style to avoid cutoffs on mobile
          element.style.width = '1920px'; // ensure enough width for charts
          element.style.maxWidth = '1080px'; // override mobile constraint
          element.style.overflow = 'visible';

          setTimeout(() => {
            const contentWidth = element.scrollWidth;
            const inchWidth = contentWidth / 96;

            const orientation = inchWidth > 8.0 ? 'landscape' : 'portrait';

            const opt = {
              margin: 0.5,
              filename: 'Attendance_Report.pdf',
              image: { type: 'jpeg', quality: 0.98 },
              html2canvas: {
                scale: 2,
                useCORS: true,
                allowTaint: true,
                scrollY: -window.scrollY,
                windowWidth: element.scrollWidth,
                width: element.scrollWidth,
                backgroundColor: '#ffffff'
              },
              jsPDF: {
                unit: 'in',
                format: 'a4',
                orientation: orientation
              },
              pagebreak: {
                mode: ['avoid'],
                avoid: ['.pdf-chart-wrapper', 'canvas']
              }
            };

            html2pdf().set(opt).from(element).save().then(() => {
              // Restore original styles after export
              element.setAttribute('style', originalStyle);
            });

          }, 500);
        }

        function loadMissedLogins() {
