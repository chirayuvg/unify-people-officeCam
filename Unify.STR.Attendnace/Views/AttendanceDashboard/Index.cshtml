        }

        #toggleButton {
        margin-top: 10px;
        }

        .chart-row {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
        }

        .chart-row .bar {
        flex: 1;
        height: 60px;
        }

        .chart-row .label {
        min-width: 120px;
        padding-left: 20px;
